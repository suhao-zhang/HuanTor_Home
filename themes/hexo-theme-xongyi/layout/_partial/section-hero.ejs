<section class="hero" id="hero">
  <div class="container hero__inner<%= theme.hero.image ? '' : ' hero__inner--center' %>">
    <div class="hero__content reveal">
      <% if (theme.hero.badge) { %>
      <span class="hero__badge"><%- icon('zap') %><%= theme.hero.badge %></span>
      <% } %>
      <h1 class="hero__title"><%- theme.hero.title %></h1>
      <% if (theme.hero.subtitle) { %>
      <p class="hero__subtitle"><%= theme.hero.subtitle %></p>
      <% } %>
      <% if (theme.hero.buttons && theme.hero.buttons.length) { %>
      <div class="hero__actions">
        <% theme.hero.buttons.forEach(function (btn) { %>
        <a class="btn <%= btn.primary ? 'btn--primary' : 'btn--ghost' %>" href="<%- url_for(btn.url) %>"><%= btn.name %><%- icon('arrow-right') %></a>
        <% }) %>
      </div>
      <% } %>
    </div>
    <% if (theme.hero.image) { %>
    <div class="hero__media reveal">
      <%# ★ 本地改版（第 6 处主题补丁）：主题把 alt 写死成空串，配图对图片搜索与
          AI 抓取等于不存在。改成读 hero.image_alt，没填则仍按装饰图输出 alt=""。
          升级主题时这行要重做。 %>
      <img src="<%- url_for(theme.hero.image) %>" alt="<%= theme.hero.image_alt || '' %>" loading="eager">
    </div>
    <% } %>
  </div>
</section>
